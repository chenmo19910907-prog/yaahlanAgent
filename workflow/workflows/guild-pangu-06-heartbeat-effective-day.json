{
  "id": "guild-pangu-06-heartbeat-effective-day",
  "name": "盘古-⑥心跳有效在麦日",
  "category": "公会常用盘古配置工具（workflow）",
  "description": "预上线：通过 shiftTime.tradeUnion 偏移，控制心跳写入的有效在麦日；在公会长主播表现页查看。 验收：上麦/心跳后有效在麦日计入偏移后的自然日。",
  "version": 1,
  "params": {
    "fixedTimeSec": {
      "label": "fixedTimeSec",
      "type": "string",
      "required": true,
      "prompt": "Unix 秒（北京时间戳）"
    },
    "expireTimeSec": {
      "label": "expireTimeSec",
      "type": "string",
      "required": false,
      "prompt": "Unix 秒；可与 fixedTimeSec 相同"
    }
  },
  "steps": [
    {
      "id": "apply_pangu_shift",
      "name": "改 MSE 配置并发布",
      "run": {
        "type": "shell",
        "command": "python3 workflow/scripts/guild_pangu_shift_time_apply.py --scenario \"heartbeat_effective_day\" --fixed-time-sec \"{{fixedTimeSec}}\" --expire-time-sec \"{{expireTimeSec}}\"",
        "cwd": "."
      },
      "expect": {
        "returncode": 0
      }
    }
  ]
}
