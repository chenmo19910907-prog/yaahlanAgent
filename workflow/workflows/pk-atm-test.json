{
  "id": "pk-atm-test",
  "name": "PK提款机-跨房PK造数验收",
  "category": "PK提款机",
  "description": "2.5.9 PK 提款机：alpha MSE 配置 → 随机匹配跨房 PK → 造数至目标总 PK → C7 赛况(Reward tab/getAcrossPkMatchStatusV2)+对战 → C8 提款排名(Ranking tab/getAcrossPkRewardRankV2) → 返钻验收。",
  "version": 1,
  "params": {
    "phoneA": {
      "label": "A方手机号",
      "type": "string",
      "required": false,
      "default": "13311111112",
      "prompt": "房主 A，默认 13311111112"
    },
    "phoneB": {
      "label": "B方手机号",
      "type": "string",
      "required": false,
      "default": "13311111113",
      "prompt": "房主 B，默认 13311111113"
    },
    "giftCount": {
      "label": "送礼账号数",
      "type": "integer",
      "required": false,
      "default": "50",
      "prompt": "10万总PK约需1万钻，默认50笔×400~600钻"
    },
    "giftMinDiamonds": {
      "label": "单笔最小钻石",
      "type": "integer",
      "required": false,
      "default": "400"
    },
    "giftMaxDiamonds": {
      "label": "单笔最大钻石",
      "type": "integer",
      "required": false,
      "default": "600"
    },
    "preGiftWait": {
      "label": "送礼前等待秒",
      "type": "integer",
      "required": false,
      "default": "20"
    },
    "postGiftWait": {
      "label": "送礼后结束PK前等待秒",
      "type": "integer",
      "required": false,
      "default": "20"
    },
    "postCloseWait": {
      "label": "结束PK后发钻等待秒",
      "type": "integer",
      "required": false,
      "default": "8"
    },
    "matchTimeout": {
      "label": "匹配超时秒",
      "type": "integer",
      "required": false,
      "default": "90",
      "prompt": "每轮随机匹配等待秒数"
    },
    "matchRetries": {
      "label": "匹配重试轮数",
      "type": "integer",
      "required": false,
      "default": "5",
      "prompt": "配错房间或超时时重试"
    },
    "pkMinute": {
      "label": "PK时长分钟",
      "type": "integer",
      "required": false,
      "default": "5",
      "prompt": "随机匹配 PK 时长，5/10/30"
    },
    "outDir": {
      "label": "报告目录",
      "type": "string",
      "required": false,
      "default": ".tmp"
    },
    "personalPkThreshold": {
      "label": "个人PK门槛",
      "type": "integer",
      "required": false,
      "default": "1000",
      "prompt": "alpha MSE minMemberRewardPk"
    },
    "minCombinedPk": {
      "label": "场次PK门槛",
      "type": "integer",
      "required": false,
      "default": "20000",
      "prompt": "alpha MSE minTotalPkValue"
    },
    "targetCombinedPk": {
      "label": "目标双方总PK",
      "type": "integer",
      "required": false,
      "default": "100000",
      "prompt": "验收双方总 PK 须达到（默认10万，命中MSE 10万档）"
    }
  },
  "steps": [
    {
      "id": "pk_atm_full_run",
      "name": "PK提款机全流程",
      "run": {
        "type": "shell",
        "command": "python3 workflow/scripts/pk_atm_test_run.py --phone-a {{phoneA}} --phone-b {{phoneB}} --gift-count {{giftCount}} --gift-min-diamonds {{giftMinDiamonds}} --gift-max-diamonds {{giftMaxDiamonds}} --pre-gift-wait {{preGiftWait}} --post-gift-wait {{postGiftWait}} --post-close-wait {{postCloseWait}} --match-timeout {{matchTimeout}} --match-retries {{matchRetries}} --pk-minute {{pkMinute}} --out-dir {{outDir}} --personal-pk-threshold {{personalPkThreshold}} --min-combined-pk {{minCombinedPk}} --target-combined-pk {{targetCombinedPk}}",
        "cwd": "."
      },
      "expect": {
        "returncode": 0
      }
    }
  ]
}
