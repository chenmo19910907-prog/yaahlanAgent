{
  "id": "anniversary-egg-smash-record",
  "name": "3周年砸金蛋-造数并记录",
  "category": "3周年活动",
  "description": "MOA smashAnniversaryEggForTest 一次砸 N 个金蛋，解析响应字段追加写入钉钉表「砸金蛋测试记录」。开发提供真实 url/method 后更新 MOA 模板。",
  "version": 1,
  "params": {
    "workbook": {
      "label": "钉钉表格",
      "type": "string",
      "required": true,
      "prompt": "alidocs 表格 URL 或 nodeId"
    },
    "userId": {
      "label": "砸蛋账号",
      "type": "string",
      "required": true,
      "prompt": "momoid / userId"
    },
    "roomId": {
      "label": "砸蛋房间",
      "type": "string",
      "required": true,
      "prompt": "roomId"
    },
    "smashCount": {
      "label": "本次砸蛋次数",
      "type": "integer",
      "required": true,
      "prompt": "一次砸 N 个金蛋"
    },
    "sheetName": {
      "label": "工作表名",
      "type": "string",
      "required": false,
      "default": "砸金蛋测试记录"
    },
    "timeoutMs": {
      "label": "MOA超时毫秒",
      "type": "integer",
      "required": false,
      "default": "60000"
    }
  },
  "steps": [
    {
      "id": "smash_and_record",
      "name": "砸金蛋并写入钉钉表",
      "run": {
        "type": "shell",
        "command": "python3 MOA/scripts/anniversary_egg_smash_record.py --workbook {{workbook}} --user-id {{userId}} --room-id {{roomId}} --smash-count {{smashCount}} --sheet-name {{sheetName}} --timeout-ms {{timeoutMs}}",
        "cwd": "."
      },
      "expect": {
        "returncode": 0
      }
    }
  ]
}
