{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["tests/**/*", "utils/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
