# ============================================================
# Midscene.js 环境配置示例
# 复制此文件为 .env 并填入真实值（.env 不要提交到 git）
# ============================================================

# ---- AI 模型配置（必填）----
# https://midscenejs.com/zh/model-common-config#doubao-seed-model

MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
MIDSCENE_MODEL_API_KEY=your-ark-api-key
MIDSCENE_MODEL_NAME=doubao-seed-2-0-lite
MIDSCENE_MODEL_FAMILY=doubao-seed
MIDSCENE_REPLANNING_CYCLE_LIMIT=40


# ---- iOS 配置 ----
# WebDriverAgent 地址和端口（默认 localhost:8100）
WDA_HOST=localhost
WDA_PORT=8100
# iOS App Bundle ID
IOS_APP_ID=live.soulchill.ios

# ---- Android 配置 ----
# 设备 UDID（留空则自动选第一台连接设备）
ANDROID_DEVICE_ID=
# Android App Package
ANDROID_APP_ID=com.live.soulchill
# 启动 Activity（相对包名格式）
ANDROID_MAIN_ACTIVITY=.module.login.LoginActivity

# ---- 测试账号配置 ----
# 建议使用测试环境专用账号
TEST_PHONE=13800138000
TEST_PHONE_PREFIX=966            # 手机区号，传给 sendVerifyCode 接口的 prefix 参数（不含+号）
TEST_VERIFY_CODE=123456          # 后端测试账号的固定 magic code（需后端配置）
TEST_PASSWORD=Test@123456
