# ============================================================
# Midscene.js 环境配置示例（Yaahlan）
# 复制此文件为 .env 并填入真实值（.env 不要提交到 git）
# ============================================================

# ---- AI 模型配置（必填）----
# https://midscenejs.com/zh/model-common-config#doubao-seed-model

MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MIDSCENE_MODEL_API_KEY=your-ark-api-key
MIDSCENE_MODEL_NAME=doubao-seed-2-0-lite-260428
MIDSCENE_MODEL_FAMILY=doubao-seed
MIDSCENE_REPLANNING_CYCLE_LIMIT=40

# ---- iOS 配置 ----
WDA_HOST=localhost
WDA_PORT=8100
IOS_APP_ID=com.immomo.biz.yaahlanNew

# ---- Android 配置 ----
ANDROID_DEVICE_ID=
ANDROID_APP_ID=com.immomo.biz.yaahlan
ANDROID_MAIN_ACTIVITY=.module.login.LoginActivity

# ---- 测试账号配置 ----
TEST_ACCOUNT_USER_ID=100261858
TEST_PHONE=13011119991
TEST_PHONE_PREFIX=86
TEST_PHONE_CODE=000000
TEST_VERIFY_CODE=000000
TEST_PASSWORD=Test@123456

# ---- 意图测试：定制礼物 uid 搜索 ----
TEST_CUSTOM_GIFT_UID=100312107
TEST_CUSTOM_GIFT_UID_PARTIAL=100312

# ---- 意图测试：定制礼物昵称搜索（npm run preflight -- --write-env 从抓包写入）----
TEST_CUSTOM_GIFT_NICKNAME=测试昵称示例
TEST_CUSTOM_GIFT_NICKNAME_KEYWORD=测试
TEST_CUSTOM_GIFT_NICKNAME_NOT_FOUND=不存在的昵称xyz999
TEST_CUSTOM_GIFT_GIFT_NAME=

# ---- 意图测试：房间 / Tunnel 抓包 ----
TEST_VOICE_ROOM_ID=80954536
TEST_TUNNEL_MOMOID=100261858
TUNNEL_KEYWORD_CUSTOM_GIFT_SEARCH=searchCustomGift
