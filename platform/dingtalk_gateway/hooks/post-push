#!/usr/bin/env bash
# Git post-push：推送含 platform/dingtalk_gateway/ 或 platform/web_agent/ 变更后静默重启
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GATEWAY_CTL="$REPO_ROOT/platform/dingtalk_gateway/gateway_ctl.sh"
WEB_AGENT_PY="$REPO_ROOT/platform/web_agent/server.py"
GATEWAY_PREFIX="platform/dingtalk_gateway/"
WEB_AGENT_PREFIX="platform/web_agent/"

[[ -x "$GATEWAY_CTL" ]] || exit 0

_null_oid="0000000000000000000000000000000000000000"
gateway_touched=0
web_agent_touched=0

_push_has_prefix_changes() {
  local prefix="$1"
  local old_sha="$2"
  local new_sha="$3"
  if [[ "$new_sha" == "$_null_oid" ]]; then
    return 1
  fi
  if [[ "$old_sha" == "$_null_oid" ]]; then
    git diff-tree --no-commit-id --name-only -r "$new_sha" | grep -q "^${prefix}"
    return
  fi
  git diff --name-only "$old_sha" "$new_sha" | grep -q "^${prefix}"
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  if _push_has_prefix_changes "$GATEWAY_PREFIX" "$remote_sha" "$local_sha"; then
    gateway_touched=1
  fi
  if _push_has_prefix_changes "$WEB_AGENT_PREFIX" "$remote_sha" "$local_sha"; then
    web_agent_touched=1
  fi
done

if [[ "$gateway_touched" -eq 1 ]]; then
  "$GATEWAY_CTL" silent-restart
fi

if [[ "$web_agent_touched" -eq 1 ]]; then
  PY="$REPO_ROOT/platform/dingtalk_gateway/.venv/bin/python3"
  if [[ ! -x "$PY" ]]; then
    PY="python3"
  fi
  "$PY" "$WEB_AGENT_PY" --ensure
fi
