# 复制为 .env.local 并填写（.env.local 不入库）

# ── Cursor SDK（必填）https://cursor.com/dashboard/integrations → API Keys
CURSOR_API_KEY=cursor_xxxxxxxx

# ── 路径 A：开放平台 Stream 机器人（群里 @ → Agent → 回群）
DINGTALK_CLIENT_ID=dingxxxxxxxx
DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 上传文件到 alidocs 目录时需要（操作者 unionId）
# DINGTALK_UNION_ID=xxxxxxxx

# ── 路径 B：自定义 Webhook 机器人（本地触发 → 结果推到群，不能收 @）
# 群设置 → 添加机器人 → 自定义 → Webhook URL + 加签 SEC 密钥
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_WEBHOOK_SECRET=SECxxxxxxxx
