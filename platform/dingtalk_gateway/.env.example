# 复制为 .env.local 并填写（.env.local 不入库）

# ── Cursor SDK（必填）https://cursor.com/dashboard/integrations → API Keys
CURSOR_API_KEY=cursor_xxxxxxxx

# ── 开放平台 Stream 机器人（群里 @ → Agent → 回群）
DINGTALK_CLIENT_ID=dingxxxxxxxx
DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 上传文件到 alidocs 目录时需要（操作者 unionId；CSV/JSON 导出用）
# DINGTALK_UNION_ID=xxxxxxxx
# 网关启停通知目标群（可选；未填则自动记住最近 @ 机器人的群 openConversationId）
# DINGTALK_NOTIFY_CONVERSATION_ID=cidxxxxxxxx==

# Agent 任务流式卡片（1=开启）；markdown=无赞踩反馈（推荐）/ ai=打字机流式
# DINGTALK_AGENT_STREAMING=1

# ── Web Agent 公网暴露（expose_public.py 必填）
# WEB_AGENT_AUTH_USER=qa-agent
# WEB_AGENT_AUTH_PASSWORD=请设强密码
# 默认 WEB_AGENT_AUTH_PUBLIC_ONLY=1：仅公网/隧道须登录，内网直连免登录
# WEB_AGENT_AUTH_PUBLIC_ONLY=0  # 全站强制登录
# 可选 IP 白名单（逗号分隔，支持 CIDR）：WEB_AGENT_ALLOW_IPS=203.0.113.0/24,198.51.100.8
# DINGTALK_AGENT_STREAMING_CARD=markdown
# ai 模式完成态会展示赞踩反馈；仅当需要收集反馈时设 CARD=ai 且 CARD_FEEDBACK=1
# DINGTALK_AGENT_STREAMING_CARD_FEEDBACK=0
# 流式卡片 API 刷新间隔（秒，默认 2；越大越稳、越小越实时）
# DINGTALK_AGENT_STREAM_RENDER_INTERVAL_S=2.0
