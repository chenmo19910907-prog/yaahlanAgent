.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #f2f5fa;
  background: linear-gradient(180deg, #0b0e14 0%, #101522 100%);
}

.logo {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.status {
  font-size: 28rpx;
  color: #a4adbd;
  text-align: center;
  line-height: 1.6;
}

.error {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #ef4444;
  text-align: center;
  line-height: 1.5;
}

.btn {
  margin-top: 40rpx;
  background: #5b8cff;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
