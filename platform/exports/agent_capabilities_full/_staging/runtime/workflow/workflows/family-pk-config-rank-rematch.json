{
  "id": "family-pk-config-rank-rematch",
  "name": "家族PK配置-收礼榜造数与档位测算",
  "category": "家族PK",
  "description": "第三步：按 Sheet2 家族成员数分段随机写入收礼榜（>10人：20万~100万；≤10人：0~20万），再按收礼榜+参数表计算次日各家族档位达标 PK 与钻石奖励，写入 Sheet3「家族PK档位」。",
  "version": 3,
  "params": {
    "workbookUrl": {
      "label": "钉钉表格",
      "type": "string",
      "required": true,
      "default": "https://alidocs.dingtalk.com/i/nodes/N7dx2rn0JbZQqA9ACZ1MoaaRJMGjLRb3",
      "prompt": "钉钉表格 URL 或 nodeId"
    },
    "rankDate": {
      "label": "收礼榜日期",
      "type": "date",
      "required": true,
      "default": "2026-07-01",
      "prompt": "收礼日榜日期 yyyy-MM-dd（可更换）"
    },
    "pkDate": {
      "label": "匹配日期",
      "type": "date",
      "required": false,
      "default": "2026-07-02",
      "prompt": "收礼榜次日；钉钉表重命名为 {pkDate}家族PK数据测试"
    }
  },
  "steps": [
    {
      "id": "set_receive_rank",
      "name": "收礼榜随机造数",
      "run": {
        "type": "shell",
        "command": "python3 MOA/scripts/family_pk_rank_rematch_prepare.py --workbook \"{{workbookUrl}}\" --rank-date {{rankDate}} --skip-rematch",
        "cwd": "."
      },
      "expect": {
        "returncode": 0
      }
    },
    {
      "id": "reward_calc_to_sheet3",
      "name": "次日家族PK档位测算写入Sheet3",
      "run": {
        "type": "shell",
        "command": "python3 platform/dingtalk_gateway/family_pk_reward_calc_to_workbook.py --workbook \"{{workbookUrl}}\" --rank-date {{rankDate}} --pk-date {{pkDate}} --sheet-name 家族PK档位",
        "cwd": "."
      },
      "expect": {
        "returncode": 0
      }
    }
  ]
}
