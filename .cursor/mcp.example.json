{
  "mcpServers": {
    "platform-tools": {
      "command": "platform/mcp/.venv/bin/python3",
      "args": [
        "platform/mcp/server.py"
      ],
      "env": {}
    },
    "adb-screen": {
      "command": "adb/mcp_adb_screen/.venv/bin/python3",
      "args": [
        "adb/mcp_adb_screen/server.py"
      ],
      "env": {}
    },
    "adb-screenshot": {
      "command": ".cursor/skills/adb-screenshot/mcp_adb_screenshot/venv/bin/python3",
      "args": [
        ".cursor/skills/adb-screenshot/mcp_adb_screenshot/server.py"
      ],
      "env": {}
    },
    "dingtalk-doc": {
      "command": ".cursor/skills/dingtalk-doc-read/mcp_dingtalk_doc/venv/bin/python3",
      "args": [
        ".cursor/skills/dingtalk-doc-read/mcp_dingtalk_doc/server.py"
      ],
      "env": {
        "DINGTALK_COOKIE": ""
      }
    },
    "dingtalk-excel-read": {
      "command": ".cursor/skills/testcase-to-excel/mcp_dingtalk_excel/venv/bin/python3",
      "args": [
        ".cursor/skills/testcase-to-excel/mcp_dingtalk_excel/server_read.py"
      ],
      "env": {
        "DINGTALK_AEGIS_KEY": "",
        "DINGTALK_AEGIS_SECRET": "",
        "DINGTALK_WORKID": ""
      }
    },
    "dingtalk-excel-write": {
      "command": ".cursor/skills/testcase-to-excel/mcp_dingtalk_excel/venv/bin/python3",
      "args": [
        ".cursor/skills/testcase-to-excel/mcp_dingtalk_excel/server_write.py"
      ],
      "env": {
        "DINGTALK_AEGIS_KEY": "",
        "DINGTALK_AEGIS_SECRET": "",
        "DINGTALK_WORKID": ""
      }
    }
  }
}
