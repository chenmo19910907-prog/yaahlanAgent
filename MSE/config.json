{
  "defaults": {
    "base_url": "https://mse.wemomo.com",
    "region": "alpha",
    "env": "alpha",
    "cluster": "stage",
    "app_key": "momo.bpm.biz.gameplatform.overseas-voga-mts-vas",
    "name_space": "voga-common",
    "server": "config"
  },
  "namespaces": {
    "voga-common": "公有通用配置",
    "voga-activity": "公有活动配置（MSE 控制台「公有/voga-activity」）",
    "Application": "私有应用配置（MSE 控制台「私有/application」；API nameSpace 为空）"
  },
  "api": {
    "read": {
      "path": "/apirest/httpproxy/config/getConfigsByAppKeyAndNameSpace",
      "method": "POST",
      "content_type": "application/x-www-form-urlencoded"
    },
    "save": {
      "path": "/apirest/httpproxy/record/saveOrUpdateConfigModel",
      "method": "POST",
      "content_type": "application/x-www-form-urlencoded",
      "body": "json={configInfoModel,advancedCheck,degradeTimePeriod}"
    },
    "publish": {
      "create": "/apirest/httpproxy/record/createPublishRecord",
      "skip_grey": "/apirest/httpproxy/record/updatePublishRecordProcess",
      "all_publish": "/apirest/httpproxy/record/allPublishByRecord",
      "check": "/apirest/httpproxy/record/getInstanceByCluster",
      "complete": "/apirest/httpproxy/record/complete"
    }
  }
}
