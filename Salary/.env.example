# 复制为 .env 后按需填写；不要提交 .env
#
# MySQL（算薪 E2E 用例依赖）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
#
# MOA：lookup 与调用依赖内网 Redis（见 momoKit/moa.py）；本机可选 /etc/momo/env.yaml 中的 lookup 配置
#
# 钉钉：执行带 --salary-report 的用例后自动发送简报（机器人关键词须为「测试报告」）
# DINGTALK_REPORT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_REPORT_TOKEN
# 或与通用脚本共用：
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# 若机器人启用加签安全设置：
# DINGTALK_SECRET=YOUR_SIGN_SECRET
#
# 简报去重（默认 300 秒内相同结果不重复发送）；强制每次发送：
# DINGTALK_FORCE_SEND=1
# DINGTALK_BRIEF_DEDUPE_TTL=300
#
# 可视化测试后台（web/main.py）
# DASHBOARD_TOKEN=change-me-to-a-long-random-string
# DASHBOARD_PORT=8088
#
# 公会进步奖政策开关（默认 202512 旧口径；新政策自结算周期 20260816 起生效）
# GUILD_PROGRESS_AWARD_POLICY=202512
# GUILD_PROGRESS_AWARD_POLICY=202608
# GUILD_PROGRESS_AWARD_POLICY=auto
# 盘古配置中心（读 MSE/应用配置，无需登录配置中心页面）
# PANGU_CONFIG_SERVER=http://alpha-stage-config-server.momo.com/configs/getConfig
# PANGU_APP_KEY=momo.bpm.biz.gameplatform.overseas-voga-mts-vas
# 默认 key：tradeMotivationMaxCycleSwitch（公会激励新版本开关）
#
# 按区域确认应得薪资（写操作，会改同区同周期确认表；默认跳过）
# RUN_CONFIRM_BY_AREA=1
# 后台凭证（不要提交）：ADMIN_SSO_TOKEN / ADMIN_YAAHLAN_JWT
# 或登录后台后存到 ~/.moa-call/gateway_credentials.json
