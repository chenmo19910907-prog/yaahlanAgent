{
  "id": "login-phone-full",
  "name": "手机号登录",
  "recordedOn": {
    "width": 1080,
    "height": 2340
  },
  "capture": "end",
  "description": "手机号登录全流程：语言 Next → 协议+手机 → SMS → 验证码（QA 默认 +86 13311111115 / 000000）。身份由 testAccounts/Tunnel 判断，与 UI 流程无关；换号用 --text 或组合 account。",
  "countryCode": "+86",
  "params": ["text"],
  "defaults": {
    "text": "13311111115"
  },
  "loginDefaults": {
    "countryCode": "+86",
    "phone": "13311111115",
    "verifyCode": "000000"
  },
  "kbRef": [
    "documents/登录注册.md（7、手机号登陆）"
  ],
  "steps": [
    {
      "sleep_ms": 500
    },
    {
      "tap_pct": [
        0.5,
        0.918
      ],
      "note": "语言 Next（无语言页时可 --skip login_lang）",
      "skip_key": "login_lang"
    },
    {
      "sleep_ms": 1200
    },
    {
      "tap_pct": [
        0.195,
        0.921
      ],
      "note": "勾选协议"
    },
    {
      "sleep_ms": 300
    },
    {
      "tap_pct": [
        0.312,
        0.855
      ],
      "note": "手机入口"
    },
    {
      "sleep_ms": 800
    },
    {
      "tap_pct": [
        0.609,
        0.317
      ],
      "note": "input_phone"
    },
    {
      "sleep_ms": 300
    },
    {
      "text": "{{text}}",
      "note": "手机号（不含区号）"
    },
    {
      "sleep_ms": 500
    },
    {
      "tap_pct": [
        0.5,
        0.504
      ],
      "note": "Get via SMS"
    },
    {
      "wait_activity": {
        "hint": "login",
        "timeout_ms": 2500,
        "poll_ms": 200,
        "note": "等待验证码页"
      }
    },
    {
      "tap_pct": [
        0.5,
        0.349
      ],
      "note": "input_code"
    },
    {
      "sleep_ms": 300
    },
    {
      "text": "000000",
      "note": "QA 验证码"
    },
    {
      "wait_activity": {
        "hints": ["home", "register"],
        "timeout_ms": 3500,
        "poll_ms": 250,
        "note": "进入首页或注册页"
      }
    },
    {
      "run_script": "登录后处理弹窗",
      "note": "已注册账号：等待签到；注册流程请 --skip login_post",
      "skip_key": "login_post"
    },
    {
      "sleep_ms": 300
    }
  ]
}
