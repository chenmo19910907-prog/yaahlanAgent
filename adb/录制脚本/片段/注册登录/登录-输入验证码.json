{
  "id": "login-verify-code",
  "name": "登录-输入验证码",
  "recordedOn": { "width": 1080, "height": 2340 },
  "capture": "end",
  "description": "验证码页：输入 6 位验证码（默认 000000）",
  "kbRef": ["documents/登录注册.md（验证码页面）"],
  "params": ["text"],
  "defaults": { "text": "000000" },
  "steps": [
    { "sleep_ms": 400 },
    {
      "resourceId": "input_code",
      "tap_pct": [0.5, 0.349],
      "fallback_tap_pct": [0.5, 0.349],
      "note": "input_code"
    },
    { "sleep_ms": 300 },
    {
      "text": "{{text}}",
      "clear_before_text": false,
      "note": "验证码"
    },
    {
      "wait_activity": {
        "hints": ["home", "register"],
        "timeout_ms": 5000,
        "poll_ms": 250,
        "note": "进入首页"
      }
    },
    { "sleep_ms": 800 }
  ]
}
