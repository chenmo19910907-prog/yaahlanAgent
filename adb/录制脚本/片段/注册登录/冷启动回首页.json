{
  "id": "cold-start-home",
  "name": "冷启动回首页",
  "recordedOn": {
    "width": 1080,
    "height": 2340
  },
  "capture": "end",
  "description": "杀进程重启 Yaahlan → 跳过开屏广告 → 验收开屏；已登录回首页。勿在 home 盲 BACK 关弹窗（会连弹退出确认）；登录后弹窗用 login verify / popup analyze。",
  "steps": [
    {
      "launch_app": "yaahlan",
      "note": "force-stop 后 LAUNCHER 冷启"
    },
    {
      "run_script": "跳过开屏广告",
      "note": "约 5s 开屏",
      "skip_key": "dismiss_splash_ad"
    },
    {
      "run_script": "验收开屏广告",
      "note": "未过则 BACK+重跑跳过，避免后续步骤全偏"
    },
    {
      "sleep_ms": 800
    }
  ]
}
