{
  "id": "post-moment",
  "name": "发布纯文本动态",
  "recordedOn": { "width": 1080, "height": 2340 },
  "capture": "end",
  "description": "从任意底栏页发布纯文本动态（动态帧 → + → 输入 → Post）",
  "params": ["text"],
  "steps": [
    { "sleep_ms": 300 },
    { "run_script": "关闭常见弹窗", "note": "切页前关挡路弹窗" },
    { "sleep_ms": 200 },
    { "tap_pct": [0.700, 0.956], "note": "Moment" },
    { "sleep_ms": 600 },
    { "tap_pct": [0.922, 0.087], "note": "publish_feed" },
    { "sleep_ms": 700 },
    { "tap_pct": [0.500, 0.190], "note": "content 正文输入区（540,444）" },
    { "sleep_ms": 400 },
    { "text": "{{text}}", "note": "输入正文" },
    { "sleep_ms": 600 },
    { "key": 4, "note": "收起键盘以免挡住 Post", "optional": true },
    { "sleep_ms": 300 },
    { "tap_pct": [0.907, 0.051], "note": "Post（980,119）" },
    { "sleep_ms": 3500, "note": "等待发布完成" }
  ]
}
