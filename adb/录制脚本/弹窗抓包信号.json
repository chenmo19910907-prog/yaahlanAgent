{
  "version": 1,
  "description": "关键操作后结合 Tunnel 抓包判断可能出现的弹窗；抓包无法覆盖的 UI 弹窗见各 scene.weakUiPopups，须配合截图读图。",
  "scenes": {
    "login": {
      "label": "登录后进首页",
      "weakUiPopups": [
        "签到半屏/WebView（signInPopupUrl，部分账号登录即有）",
        "Account Security 绑定手机/邮箱",
        "Crowd Testing 众测邀请",
        "运营/礼包全屏（部分无独立接口）"
      ],
      "signals": [
        {
          "id": "sign-in-popup",
          "urlPatterns": ["sign/signInList"],
          "uiPopup": "登录后签到半屏（surprise H5 / WebView）",
          "rules": [
            { "path": "response.data.signInPopupUrl", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭签到弹窗",
          "confidence": "high"
        },
        {
          "id": "sign-in-task-flag",
          "urlPatterns": ["task/checkTaskCanReward"],
          "uiPopup": "任务可领奖（常伴随签到引导）",
          "rules": [
            { "path": "response.data.flag", "op": "eq", "value": 1 }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭签到弹窗",
          "confidence": "medium"
        },
        {
          "id": "popup-config-sign-in",
          "urlPatterns": ["config/getPopupConfig"],
          "uiPopup": "首页弹窗队列含 signIn（order 40）",
          "rules": [
            { "path": "response.data.home", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "登录后处理弹窗",
          "confidence": "info"
        },
        {
          "id": "first-recharge-entrance",
          "urlPatterns": ["first-recharge/rechargeEntrance"],
          "uiPopup": "首充/充值运营弹窗",
          "rules": [
            { "path": "response.data.isFirstRecharge", "op": "eq", "value": 1 },
            { "path": "response.data.rechargeAlertV2CountDownSeconds", "op": "gt", "value": 0 }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "high"
        },
        {
          "id": "first-recharge-wheel",
          "urlPatterns": ["firstRechargeWheelInfo"],
          "uiPopup": "首充转盘/运营 H5",
          "rules": [
            { "path": "response.data.alertWebUrl", "op": "notEmpty" },
            { "path": "response.data.status", "op": "ne", "value": 0 }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "medium"
        },
        {
          "id": "recharge-page-banner",
          "urlPatterns": ["recharge/rechargePageData"],
          "uiPopup": "钱包/充值页 Banner（误点 + 会进 Top up）",
          "rules": [
            { "path": "response.data.rechargeBannerInfo", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "low"
        }
      ]
    },
    "splash": {
      "label": "冷启动开屏广告（约 5s）",
      "weakUiPopups": [
        "全屏开屏广告（跳过按钮右上角）",
        "广告未结束就点击 → 进入广告 H5 WebView",
        "开屏期间误点导致后续步骤全偏"
      ],
      "signals": [
        {
          "id": "open-screen-ad",
          "urlPatterns": ["ad/getOpenScreenAd"],
          "uiPopup": "开屏广告配置（有 data.url / gotoUrl 时会展示）",
          "rules": [
            { "path": "response.data.url", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "跳过开屏广告",
          "confidence": "high"
        },
        {
          "id": "splash-home-ready",
          "urlPatterns": ["getUserConfigs", "simpleUserInfo", "app-config/redCount"],
          "uiPopup": "主页接口已拉取（开屏应已结束，可继续操作）",
          "rules": [
            { "path": "response.ec", "op": "eq", "value": 200 }
          ],
          "ruleMode": "any",
          "dismissScript": null,
          "confidence": "info"
        }
      ]
    },
    "home": {
      "label": "首页/底栏切换后",
      "weakUiPopups": [
        "运营全屏广告",
        "签到/任务半屏",
        "版本更新提示"
      ],
      "signals": [
        {
          "id": "first-recharge-entrance",
          "urlPatterns": ["first-recharge/rechargeEntrance"],
          "uiPopup": "首充/充值运营弹窗",
          "rules": [
            { "path": "response.data.isFirstRecharge", "op": "eq", "value": 1 },
            { "path": "response.data.rechargeAlertV2CountDownSeconds", "op": "gt", "value": 0 }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "high"
        },
        {
          "id": "companion-chat-task",
          "urlPatterns": ["companion-task"],
          "uiPopup": "陪聊/任务相关引导",
          "rules": [
            { "path": "response.data.taskUserIds", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "low"
        }
      ]
    },
    "me": {
      "label": "进入 Me/个人页",
      "weakUiPopups": [
        "Crowd Testing Invitation 众测",
        "Account Security 绑定提示",
        "真人认证半屏"
      ],
      "signals": [
        {
          "id": "personal-homepage",
          "urlPatterns": ["personalHomePageUserInfo", "homepage/personal"],
          "uiPopup": "个人主页数据加载（随后易叠 UI 弹窗）",
          "rules": [],
          "ruleMode": "any",
          "dismissScript": "关闭Me页弹窗",
          "confidence": "info"
        },
        {
          "id": "first-recharge-entrance",
          "urlPatterns": ["first-recharge/rechargeEntrance"],
          "uiPopup": "首充/充值运营弹窗",
          "rules": [
            { "path": "response.data.isFirstRecharge", "op": "eq", "value": 1 }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭Me页弹窗",
          "confidence": "high"
        }
      ]
    },
    "room": {
      "label": "进入语音房",
      "weakUiPopups": [
        "Lucky Wish 全屏广告",
        "Mic invitation 上麦邀请（进他人房约 2～5s 后顶部横幅）",
        "Join 加入房间",
        "房间设置/更多菜单误开",
        "录音权限系统弹窗（非 HTTP）"
      ],
      "signals": [
        {
          "id": "room-entrance-v3",
          "urlPatterns": ["entranceV3", "room/profile/get"],
          "uiPopup": "房间挂件/宝箱入口（Lucky Wish、Gift Challenge 等）",
          "rules": [
            { "path": "response.data.entranceList", "op": "notEmpty" }
          ],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "medium"
        },
        {
          "id": "room-heartbeat",
          "urlPatterns": ["room/heart/heartbeat"],
          "uiPopup": "已在房内（heartbeat 仅作进房佐证，不表示无弹窗）",
          "rules": [],
          "ruleMode": "any",
          "dismissScript": null,
          "confidence": "info"
        },
        {
          "id": "room-gift-rank",
          "urlPatterns": ["rank/room/gift"],
          "uiPopup": "礼物榜/小时榜数据（可能伴随机房 PK 提示）",
          "rules": [],
          "ruleMode": "any",
          "dismissScript": "关闭常见弹窗",
          "confidence": "low"
        }
      ]
    },
    "mic": {
      "label": "开麦/上麦",
      "weakUiPopups": [
        "Mic invitation（Reject/Accept）",
        "录音权限系统弹窗",
        "上麦协议/风险提示"
      ],
      "signals": [
        {
          "id": "room-heartbeat",
          "urlPatterns": ["room/heart/heartbeat"],
          "uiPopup": "房内心跳（开麦前后应有 heartbeat；无则可能未进房）",
          "rules": [],
          "ruleMode": "any",
          "dismissScript": null,
          "confidence": "info"
        }
      ]
    }
  },
  "defaultDismissScript": "关闭常见弹窗",
  "meDismissScript": "关闭Me页弹窗",
  "dismissSkipWhenNoPopup": "dismiss_popup_taps"
}
