{
  "id": "P0-动态-发布纯文本动态",
  "priority": "P0",
  "name": "发布纯文本动态成功",
  "module": "动态",
  "source": {
    "manualCaseRef": "动态-发布纯文本动态",
    "prdRef": "documents/moments/basic module.md"
  },
  "account": {
    "alias": "familyLeader",
    "precondition": "账号已登录或可通过手机号登录；真机 adb devices=device"
  },
  "operationFlowDoc": [
    "1. 确认 familyLeader 账号空闲",
    "2. 冷启动 Yaahlan",
    "3. 手机号登录",
    "4. 发布纯文本动态（正文 autotest+时间戳）",
    "5. 抓包验收 feed 写接口 ec=200",
    "6. 留存发布后截图"
  ],
  "operations": [
    {
      "step": 1,
      "description": "确认测试账号空闲",
      "action": "account_check",
      "account": "familyLeader",
      "expectInUse": false,
      "sinceSeconds": 300
    },
    {
      "step": 2,
      "description": "冷启动 Yaahlan",
      "action": "macro",
      "script": "启动Yaahlan",
      "noCapture": true
    },
    {
      "step": 3,
      "description": "手机号登录",
      "action": "macro",
      "script": "手机号登录",
      "textFrom": "account.phone",
      "popupScene": "login",
      "popupAutoDismiss": true,
      "tunnel": {
        "account": "familyLeader",
        "keyword": "login",
        "waitSeconds": 30,
        "expectEc": 200
      }
    },
    {
      "step": 4,
      "description": "发布纯文本动态",
      "action": "macro",
      "script": "发布纯文本动态",
      "text": "autotest8888",
      "tunnel": {
        "account": "familyLeader",
        "keyword": "feed",
        "waitSeconds": 30,
        "expectEc": 200
      }
    }
  ],
  "verifyPoints": [
    {
      "id": "VP-SCREENSHOT",
      "name": "留存发布后截图",
      "method": "screenshot",
      "required": true
    }
  ],
  "stopOnFailure": true,
  "skipVerifyOnFailure": true
}
