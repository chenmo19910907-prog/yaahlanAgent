{
  "注册登录": {
    "确保登录语言为英语": {
      "note": "语言选择页选 English→Next；登录页非英语则 language→English→Next",
      "expectSceneAfter": ["login", "LoginActivity"]
    },
    "点击语言English": {
      "tapPct": [0.5, 0.356],
      "label": "English",
      "requireSceneBefore": ["HomeSelectLanguage", "Language"],
      "optional": true,
      "note": "语言选择页点 English"
    },
    "点击语言Next": {
      "tapPct": [0.5, 0.918],
      "requireSceneBefore": ["HomeSelectLanguage", "Language", "login"],
      "optional": true,
      "note": "语言页 Next（无则跳过）"
    },
    "勾选协议": {
      "tapPct": [0.804, 0.931],
      "resourceId": "img_check_terms",
      "requireSceneBefore": ["login", "LoginActivity"],
      "strict": true,
      "note": "登录页协议勾选（右侧圆圈）"
    },
    "返回": {
      "requireSceneBefore": ["webview", "WebView"],
      "optional": true,
      "note": "协议 H5 页返回登录"
    },
    "点击手机号登录": {
      "tapPct": [0.688, 0.874],
      "resourceId": "phone",
      "requireSceneBefore": ["login", "LoginActivity"],
      "strict": true,
      "note": "手机图标入口"
    },
    "点击手机号输入框": {
      "resourceId": "input_phone",
      "tapPct": [0.359, 0.317],
      "label": "Phone number",
      "requireSceneBefore": ["login", "PhoneLogin"],
      "strict": true,
      "note": "手机号输入框"
    },
    "输入手机号": {
      "requireSceneBefore": ["login", "PhoneLogin"],
      "strict": true,
      "clearBefore": false,
      "note": "填写手机号（清数据后输入框为空，勿连发 DEL）"
    },
    "点击Get via SMS": {
      "tapPct": [0.5, 0.487],
      "resourceId": "ll_phone_sms",
      "label": "Get via SMS",
      "requireSceneBefore": ["login", "PhoneLogin"],
      "strict": true,
      "note": "发送验证码"
    },
    "点击验证码输入框": {
      "resourceId": "input_code",
      "tapPct": [0.5, 0.349],
      "requireSceneBefore": ["login", "Sms", "Code"],
      "strict": true,
      "note": "验证码输入框"
    },
    "输入验证码": {
      "requireSceneBefore": ["login", "Sms", "Code"],
      "strict": true,
      "note": "填写验证码"
    },
    "点击允许定位权限": {
      "tapPct": [0.5, 0.779],
      "resourceId": "permission_allow_foreground_only_button",
      "label": "仅在前台使用应用时允许",
      "requireSceneBefore": ["GrantPermissions", "permission"],
      "optional": true,
      "note": "定位权限：仅在前台使用应用时允许"
    },
    "点击我的底栏": {
      "resourceId": "tab_profile",
      "tapPct": [0.9, 0.956],
      "requireSceneBefore": ["home", "MainActivity", "feed_list", "UserFeedListActivity"],
      "forbidSceneBefore": ["login", "RoomGameActivity", "room_game"],
      "expectSceneAfter": ["profile", "me", "MainActivity"],
      "note": "Me 底栏"
    },
    "上滑我的页": {
      "requireSceneBefore": ["home", "MainActivity", "profile", "me"],
      "swipe": {"x1_pct": 0.5, "y1_pct": 0.34, "x2_pct": 0.5, "y2_pct": 0.73, "duration_ms": 300},
      "note": "Me 页滑到顶部（对齐退出登录片段）"
    },
    "点击设置": {
      "tapPct": [0.922, 0.068],
      "tapOnly": true,
      "requireSceneBefore": ["home", "MainActivity", "profile", "me"],
      "forbidSceneBefore": ["feed_publish", "PostActivity", "room_game"],
      "expectSceneAfter": ["setting", "Setting"],
      "note": "Me 页设置齿轮（须先 Game→Me，勿在 Moment 帧）"
    },
    "点击Log out": {
      "tapPct": [0.5, 0.942],
      "label": "Log out",
      "requireSceneBefore": ["setting", "Setting"],
      "expectSceneAfter": ["login", "LoginActivity"],
      "note": "设置页 Log out"
    }
  },
  "个人主页": {
    "点击个人资料头像": {
      "tapPct": [0.1, 0.128],
      "requireSceneBefore": ["profile", "me", "MainActivity"],
      "expectSceneAfter": ["ProfileActivity", "profile"],
      "note": "Me 页头像进入 ProfileActivity"
    },
    "截图到桌面": {
      "maxEdge": 1170,
      "note": "个人主页截图保存到 ~/Desktop/yaahlan-profile-{phone}.png"
    }
  },
  "动态": {
    "点击Game底栏": {
      "resourceId": "tab_game",
      "tapPct": [0.1, 0.956],
      "requireSceneBefore": ["home", "MainActivity"],
      "forbidSceneBefore": ["room_game", "RoomGameActivity", "ChatActivity", "feed_publish"],
      "expectSceneAfter": ["home", "MainActivity"],
      "note": "回五底栏 Game 帧"
    },
    "点击动态底栏": {
      "resourceId": "tab_feed",
      "tapPct": [0.7, 0.956],
      "requireSceneBefore": ["home", "MainActivity"],
      "forbidSceneBefore": ["room_game", "RoomGameActivity", "ChatActivity", "webview"],
      "expectSceneAfter": ["home", "MainActivity"],
      "note": "底部 Moment 底栏"
    },
    "点击发布": {
      "resourceId": "publish_feed",
      "tapPct": [0.922, 0.087],
      "requireSceneBefore": ["home", "MainActivity"],
      "forbidSceneBefore": ["room_game", "RoomGameActivity", "ChatActivity", "webview"],
      "expectSceneAfter": ["feed_publish", "PostActivity", "webview"],
      "note": "Moment 右上角 +"
    },
    "点击上传区": {
      "resourceId": "main",
      "tapPct": [0.198, 0.375],
      "requireSceneBefore": ["feed_publish", "PostActivity", "webview"],
      "note": "发布页左侧上传格"
    },
    "点击相册": {
      "resourceId": "select_by_album",
      "tapPct": [0.5, 0.856],
      "label": "Ablum",
      "requireSceneBefore": ["feed_publish", "PostActivity", "webview"],
      "note": "底部 Album 菜单"
    },
    "选择相册视频": {
      "resourceId": "icon",
      "tapPct": [0.498, 0.626],
      "requireSceneBefore": ["webview", "feed_publish", "PostActivity"],
      "note": "相册网格默认视频格"
    },
    "点击Confirm": {
      "resourceId": "preview_select_finish",
      "tapPct": [0.878, 0.965],
      "label": "Confirm",
      "requireSceneBefore": ["webview", "feed_publish", "PostActivity", "VideoPreview"],
      "expectSceneAfter": ["feed_publish", "PostActivity", "webview"],
      "note": "预览 Confirm"
    },
    "点击Post": {
      "resourceId": "post",
      "tapPct": [0.881, 0.068],
      "label": "Post",
      "requireSceneBefore": ["feed_publish", "PostActivity", "webview"],
      "expectSceneAfter": ["feed_publish", "feed_list", "UserFeedListActivity", "home", "MainActivity"],
      "note": "提交发布"
    },
    "等待15秒": {
      "expectSceneAfter": ["feed_list", "UserFeedListActivity", "home", "MainActivity"]
    }
  }
}
