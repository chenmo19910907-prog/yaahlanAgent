{
  "name": "e2e",
  "description": "知识库 + MOA/Tunnel + 视觉反馈的自然语言安卓自动化",
  "driver": "adb-observe",
  "loop": {
    "name": "perceive-think-act",
    "description": "识别 → 思考 → 执行；单步目标 ≤3s",
    "timing": {
      "stepBudgetMs": 3000,
      "perceiveMs": 1400,
      "thinkMs": 100,
      "actMs": 600,
      "postActMs": 800,
      "subprocessTimeoutSec": 2.5
    },
    "perceive": {
      "mode": "fast",
      "uiLimit": 30
    },
    "postAct": {
      "mode": "activity",
      "maxWaitSec": 0.5
    }
  },
  "knowledge": {
    "testcaseKb": "testcase-kb",
    "verifiedKb": "verified-kb"
  },
  "reports": {
    "dir": "e2e/reports",
    "formats": ["json"]
  },
  "integrations": {
    "adb": "adb/adb_execute.py",
    "moa": "MOA/moa_execute.py",
    "admin": "Admin/admin_execute.py",
    "tunnel": "Tunnel/tunnel_execute.py",
    "risk": "Risk/risk_execute.py",
    "online": "online/online_execute.py"
  }
}
